{
  "name": "electron-git-updater",
  "version": "0.1.0",
  "description": "Drop-in git-pull auto-updater for source-run Electron apps: detects incoming commits, shows a localized banner, then rebuilds and relaunches the packaged app.",
  "license": "MIT",
  "author": "Alexander Harbavets",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./main": { "types": "./main.d.ts", "default": "./main.js" },
    "./preload": { "types": "./preload.d.ts", "default": "./preload.js" },
    "./renderer": { "types": "./renderer.d.ts", "default": "./renderer.js" }
  },
  "files": [
    "index.js",
    "main.js",
    "preload.js",
    "renderer.js",
    "i18n.js",
    "index.d.ts",
    "main.d.ts",
    "preload.d.ts",
    "renderer.d.ts",
    "scripts"
  ],
  "keywords": ["electron", "auto-update", "git", "updater"],
  "peerDependencies": {
    "electron": ">=16"
  }
}
