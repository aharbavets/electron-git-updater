{
  "name": "electron-git-updater",
  "version": "0.3.0",
  "description": "Drop-in git-pull auto-updater for source-run Electron apps: detects when the running build is behind the source, then rebuilds and relaunches it in a visible Terminal. No UI \u2014 your app draws its own.",
  "license": "MIT",
  "author": "Alexander Harbavets",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./main": {
      "types": "./main.d.ts",
      "default": "./main.js"
    },
    "./preload": {
      "types": "./preload.d.ts",
      "default": "./preload.js"
    },
    "./renderer": {
      "types": "./renderer.d.ts",
      "default": "./renderer.js"
    },
    "./webpack": {
      "types": "./webpack.d.ts",
      "default": "./webpack.js"
    }
  },
  "files": [
    "index.js",
    "main.js",
    "preload.js",
    "renderer.js",
    "i18n.js",
    "index.d.ts",
    "main.d.ts",
    "preload.d.ts",
    "renderer.d.ts",
    "scripts",
    "webpack.js",
    "webpack.d.ts",
    "docs"
  ],
  "keywords": [
    "electron",
    "auto-update",
    "git",
    "updater"
  ],
  "peerDependencies": {
    "electron": ">=16"
  }
}
